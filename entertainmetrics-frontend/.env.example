# Copy to .env.local (ignored by git) or set in the hosting provider (e.g. Vercel),
# then replace the placeholders with your project's values.

# URL of the EntertainMetrics FastAPI backend (no trailing slash).
# Defaults to http://127.0.0.1:8000 when not set.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase Auth (Supabase -> Project Settings -> API). Both values are public:
# the publishable key is safe for browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
