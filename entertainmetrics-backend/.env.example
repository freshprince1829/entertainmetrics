# EntertainMetrics backend configuration. Copy to .env and fill in.
# Never commit .env.

# PostgreSQL connection string (Supabase -> Project Settings -> Database).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase Auth: used to verify sign-in tokens. Both values are public
# (the publishable key is safe for browsers); they are not secrets.
SUPABASE_URL=https://gqhynlznfflxdalxcmat.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Pe9ThN7KVKpHnVEhEsHAaQ_mPcJ5-kl

# Comma-separated list of frontend origins allowed to call the API.
# Add the deployed frontend URL (e.g. https://your-app.vercel.app) in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
